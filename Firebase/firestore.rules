rules_version = '2';
// CNSNN security rules for the free Spark plan: no Cloud Functions, so every
// official value (daily time, points, leaderboard totals) is recomputed or
// cross-checked here from server timestamps and documents the client cannot rewrite.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function at(p) { return path('/databases/' + database + '/documents/' + p); }
  // Admins: a signed Firebase Auth claim, or an admins/{uid} document created from the console.
  function admin() {
   return signedIn() && (request.auth.token.get('admin', false) == true || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
  }
  function validName(n) { return n is string && n.size() >= 2 && n.size() <= 20 && cleanName(n); }
  // Same lists as Core/NameFilter.swift: offensive words anywhere, ambiguous ones only as the whole pseudo.
  function cleanName(n) {
   let k = n.lower().replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't')
    .replace('@', 'a').replace('[$]', 's').replace('[^a-zàâäçéèêëîïôöùûüÿ]', '');
   return !k.matches('.*(putain|salope|salaud|encul|niquer|niquetamere|niktamer|connard|connasse|conasse|b[aâ]tard|merde|couille|p[eé]do|hitler|n[eèé]gre|bougnoul|youpin|bicot|tapette|tafiole|gouine|porno|sexe|fuck|shit|bitch|cunt|nigg|whore|slut|enfoir|filsdepute|fdp|daech).*')
    && !k.matches('(pute|lapute|con|lecon|nazi|bite|pd|ntm|nique|p[eé]d[eé]|viol|suce|sucemoi)');
  }
  // Suspended players keep reading, but can no longer play ranked, propose, report or rename.
  function acceptsRules(d) { return d.rulesVersion is int && d.rulesVersion >= 1 && d.rulesVersion <= 100 && d.rulesAcceptedAt == request.time; }
  // While deleting the whole account: the profile is gone (or goes in the same batch).
  function leaving() { return signedIn() && !existsAfter(at('users/' + request.auth.uid)); }
  function active() { return signedIn() && !exists(at('banned/' + request.auth.uid)); }
  function categories() { return ['Général','Football','Cinéma','Géographie','Animaux','Objets']; }
  function difficulties() { return ['Facile','Moyen','Difficile']; }
  function validCard(c) {
   return c.wordFull is string && c.wordFull.size() >= 3 && c.wordFull.size() <= 80
    && c.wordNoVowels is string && c.wordNoVowels.size() >= 1 && c.wordNoVowels.size() <= 40
    && c.normalizedAnswer is string && c.normalizedAnswer.size() >= 3 && c.normalizedAnswer.size() <= 40
    && c.normalizedAnswer.matches('^[A-Z]+$')
    && c.hint is string && c.hint.size() >= 5 && c.hint.size() <= 160
    && c.category in categories() && c.difficulty in difficulties();
  }

  // ---- Calendar helpers. Daily keys are yyyy-MM-dd on the player's own calendar: the word changes
  // at local midnight, like on the phone. A day lasts from its midnight in the first time zone
  // (UTC+14) to its end in the last one (UTC-12).
  function validDayKey(day) { return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function dayDate(day) {
   let p = day.split('-');
   return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
  }
  function sameDate(t, day) { let d = dayDate(day); return t.year() == d.year() && t.month() == d.month() && t.day() == d.day(); }
  // Today somewhere on Earth: from 14 h before the day's midnight (UTC) to 12 h after its end.
  function isToday(day) {
   return validDayKey(day) && request.time >= dayDate(day) - duration.value(14, 'h')
    && request.time < dayDate(day) + duration.value(36, 'h');
  }
  function isPreviousDay(previous, day) {
   return validDayKey(previous) && sameDate(dayDate(day) - duration.value(1, 'd'), previous);
  }
  // Daily difficulty follows the weekday: Monday-Tuesday easy, Wednesday-Friday medium, weekend hard.
  function dailyBase(day) {
   let w = dayDate(day).dayOfWeek();
   return w <= 2 ? 50 : (w <= 5 ? 100 : 150);
  }
  function atLeastZero(n) { return n > 0 ? n : 0; }
  function larger(a, b) { return a > b ? a : b; }
  function smaller(a, b) { return a < b ? a : b; }
  // Same formula as Core/GameRules.swift Scoring.points.
  function dailyPoints(day, timeMs, usedHint, correct) {
   let raw = dailyBase(day) + atLeastZero(50 - math.floor(timeMs / 1000));
   return !correct ? 0 : (usedHint ? math.floor(raw / 2) : raw);
  }

  // ---- Profiles
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid)
    && request.resource.data.keys().hasOnly(['uid','username','createdAt','updatedAt','score','gamesPlayed','correctAnswers','bestTimeMs','currentStreak','rulesVersion','rulesAcceptedAt'])
    && (!('rulesVersion' in request.resource.data) || acceptsRules(request.resource.data))
    && request.resource.data.uid == uid && validName(request.resource.data.username)
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
    && request.resource.data.score == 0 && request.resource.data.gamesPlayed == 0
    && request.resource.data.correctAnswers == 0 && request.resource.data.bestTimeMs == null && request.resource.data.currentStreak == 0;
   // Rename, or consume the card proposal quota (see cards).
   allow update: if owner(uid) && active()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','updatedAt','lastProposalAt','proposalWindowAt','proposalCount'])
    && validName(request.resource.data.username) && request.resource.data.updatedAt == request.time
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastProposalAt','proposalWindowAt','proposalCount'])
     || consumesProposalQuota(resource.data, request.resource.data));
   // Accepting the community rules (a newer version is accepted again), even while suspended.
   allow update: if owner(uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rulesVersion','rulesAcceptedAt'])
    && acceptsRules(request.resource.data);
   allow delete: if owner(uid);

   // Synced practice progress (Classic points, history, local stats): owner only, not official.
   match /private/{docId} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid) && docId == 'progress'
     && request.resource.data.keys().hasOnly(['json','schema','updatedAt'])
     && request.resource.data.json is string && request.resource.data.json.size() <= 900000
     && request.resource.data.schema is int && request.resource.data.updatedAt == request.time;
   }
   // Friends the player added with a friend code: private to the player. Their results are public anyway.
   match /friends/{friendId} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid) && friendId != uid
     && request.resource.data.keys().hasOnly(['username','addedAt'])
     && validName(request.resource.data.username) && request.resource.data.addedAt == request.time;
   }
  }
  // Friend codes: 6 unambiguous characters naming one player. Anyone signed in may look up a code,
  // but only list their own, so codes cannot be enumerated.
  match /friendCodes/{code} {
   allow get: if signedIn();
   allow list: if signedIn() && resource.data.uid == request.auth.uid;
   allow create: if active() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
    && request.resource.data.keys().hasOnly(['uid','username','createdAt'])
    && request.resource.data.uid == request.auth.uid && validName(request.resource.data.username)
    && request.resource.data.createdAt == request.time;
   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }
  // Invite codes of challenges by link: 6 characters naming one challenge, looked up like friend codes.
  match /challengeInvites/{code} {
   allow get: if signedIn();
   allow list: if signedIn() && resource.data.from == request.auth.uid;
   allow create: if active() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
    && request.resource.data.keys().hasOnly(['challenge','from','createdAt'])
    && request.resource.data.from == request.auth.uid && request.resource.data.createdAt == request.time
    && request.resource.data.challenge is string
    && getAfter(at('challenges/' + request.resource.data.challenge)).data.from == request.auth.uid
    && getAfter(at('challenges/' + request.resource.data.challenge)).data.code == code;
   allow delete: if signedIn() && resource.data.from == request.auth.uid;
  }
  // Suspensions, decided by moderators from the leaderboard or a report.
  match /banned/{uid} {
   allow get: if owner(uid) || admin();
   allow list: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['username','reason','bannedAt','bannedBy'])
    && request.resource.data.username is string && request.resource.data.username.size() <= 40
    && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
    && request.resource.data.bannedBy == request.auth.uid && request.resource.data.bannedAt == request.time;
   allow delete: if admin() || (owner(uid) && leaving());
  }
  // Left by a deleted account (no personal data), so friends can drop it from their list.
  match /deletedUsers/{uid} {
   allow get: if signedIn();
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['deletedAt']) && request.resource.data.deletedAt == request.time;
   allow list, update, delete: if false;
  }
  match /admins/{uid} {
   allow read: if owner(uid);
   allow write: if false;
  }

  // ---- Daily word: one session per player and day, timed by the server.
  match /dailySessions/{id} {
   allow read: if owner(resource.data.userId) || admin();
   allow create: if active()
    && request.resource.data.keys().hasOnly(['userId','day','cardId','startedAt','hintUsed'])
    && request.resource.data.userId == request.auth.uid
    && id == request.auth.uid + '_' + request.resource.data.day
    && isToday(request.resource.data.day)
    && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 80
    && request.resource.data.startedAt == request.time && request.resource.data.hintUsed == false
    && exists(at('users/' + request.auth.uid));
   // Reveal the hint once, register a guess, or finish once. Nothing can be rewound.
   allow update: if owner(resource.data.userId) && !('finishedAt' in resource.data) && (
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hintUsed'])
      && request.resource.data.hintUsed == true)
     || registersGuess(resource.data, request.resource.data)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finishedAt','correct','wrongAnswers','answer'])
      && request.resource.data.finishedAt == request.time && request.resource.data.correct is bool
      && finishes(resource.data, request.resource.data))
   );
   // Only while deleting the whole account.
   allow delete: if owner(resource.data.userId) && leaving();
  }

  // Every guess is counted on the server before it can be checked: at most 20 a day, one per second.
  // So a script cannot try answers until one is accepted.
  function maxGuesses() { return 20; }
  function registersGuess(old, s) {
   return s.diff(old).affectedKeys().hasOnly(['guesses','guess','guessAt'])
    && s.guesses == old.get('guesses', 0) + 1 && s.guesses <= maxGuesses()
    && s.guess is string && s.guess.size() >= 1 && s.guess.size() <= 80
    && s.guessAt == request.time
    && (!('guessAt' in old) || request.time > old.guessAt + duration.value(1, 's'));
  }
  // A win names the last registered guess (which must be the word), no sooner than 2 s after the start.
  // The wrong answers are the registered guesses, so "sans faute" cannot be forged either.
  function finishes(old, s) {
   let guesses = old.get('guesses', 0);
   return s.wrongAnswers is int && (s.correct
    ? s.get('answer', '') == old.get('guess', null) && s.wrongAnswers == guesses - 1
      && request.time > old.startedAt + duration.value(2, 's') && provesAnswer(old.day, s)
    : !('answer' in s) && s.wrongAnswers == guesses);
  }
  // A win on a secret daily word must carry the right answer: a wrong guess is simply refused.
  function provesAnswer(day, s) {
   return (!('answer' in s) || (s.answer is string && s.answer.size() <= 80))
    // Every day from the first secret one has a secret: a missing one never makes a free win.
    && (!s.correct || (exists(at('dailySecrets/' + day)) ? s.get('answer', '') == get(at('dailySecrets/' + day)).data.answer : day < '2026-10-14'));
  }
  function mySession(day) { return at('dailySessions/' + request.auth.uid + '_' + day); }
  function finishedMine(day) { return exists(mySession(day)) && ('finishedAt' in get(mySession(day)).data); }
  // Over everywhere (the answer can then be public): after the last time zone's midnight.
  function dayOver(day) { return validDayKey(day) && request.time >= dayDate(day) + duration.value(36, 'h'); }

  // ---- Secret daily words, written only by the publishing tool (Admin SDK).
  // Consonants: today and past days. Hint: once the player revealed it or finished.
  // Answer: once the player finished, or after the day is over.
  match /dailyPuzzles/{day} {
   allow get: if signedIn() && (isToday(day) || dayOver(day));
   allow list, write: if false;
  }
  match /dailyHints/{day} {
   allow get: if signedIn() && (dayOver(day) || admin() || (exists(mySession(day))
    && (get(mySession(day)).data.hintUsed == true || ('finishedAt' in get(mySession(day)).data))));
   allow list, write: if false;
  }
  match /dailySecrets/{day} {
   allow get: if signedIn() && (dayOver(day) || admin() || finishedMine(day));
   allow list, write: if false;
  }

  // Public official results: everything is copied from the finished session and recomputed.
  match /dailyResults/{id} {
   allow read: if signedIn();
   allow create: if active() && createsResult(id, request.resource.data, get(at('dailySessions/' + id)).data);
   // A suspension hides the results without deleting them, so lifting it gives everything back.
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
    && (!('suspended' in request.resource.data) || request.resource.data.suspended == true);
   allow delete: if (owner(resource.data.userId) && leaving()) || admin();
  }
  function createsResult(id, r, s) {
   return r.keys().hasOnly(['userId','username','day','cardId','correct','usedHint','wrongAnswers','timeMs','points','startedAt','finishedAt'])
    && r.userId == request.auth.uid && id == request.auth.uid + '_' + r.day
    && s.userId == r.userId && s.day == r.day && s.cardId == r.cardId && ('finishedAt' in s)
    && r.startedAt == s.startedAt && r.finishedAt == s.finishedAt
    && r.correct == s.correct && r.usedHint == s.hintUsed && r.wrongAnswers == s.wrongAnswers
    && r.timeMs == s.finishedAt.toMillis() - s.startedAt.toMillis()
    && r.points == dailyPoints(r.day, r.timeMs, r.usedHint, r.correct)
    && r.username == get(at('users/' + request.auth.uid)).data.username
    // Must be tallied in the same batch, so totals and results never diverge.
    && getAfter(at('leaderboard/' + request.auth.uid)).data.lastResult == r.day;
  }

  // ---- Leaderboard totals: they can only move by exactly one new result.
  match /leaderboard/{uid} {
   allow read: if signedIn();
   allow create: if owner(uid) && tallies(uid, {'points':0,'played':0,'wins':0,'streak':0,'bestStreak':0,'bestTimeMs':null,'lastWinDay':''}, request.resource.data);
   allow update: if owner(uid) && (
     tallies(uid, resource.data, request.resource.data)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','updatedAt'])
      && request.resource.data.username == getAfter(at('users/' + uid)).data.username && request.resource.data.updatedAt == request.time)
   );
   // Suspension: hidden from the rankings, totals kept.
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
    && (!('suspended' in request.resource.data) || request.resource.data.suspended == true);
   allow delete: if owner(uid) || admin();
  }
  function tallies(uid, old, n) {
   let day = n.lastResult;
   let path = at('dailyResults/' + uid + '_' + validDayKeyOr(day));
   let r = getAfter(path).data;
   let laterWin = r.correct && day > old.lastWinDay;
   let streak = laterWin ? (isPreviousDay(old.lastWinDay, day) ? old.streak + 1 : 1) : (!r.correct && day > old.lastWinDay ? 0 : old.streak);
   return n.keys().hasOnly(['uid','username','points','played','wins','streak','bestStreak','bestTimeMs','lastWinDay','lastResult','updatedAt'])
    && validDayKey(day) && !exists(path) && existsAfter(path)
    && n.uid == uid && n.username == r.username && n.updatedAt == request.time
    && n.points == old.points + r.points && n.played == old.played + 1
    && n.wins == old.wins + (r.correct ? 1 : 0)
    && n.streak == streak && n.bestStreak == larger(old.bestStreak, streak)
    && n.bestTimeMs == (r.correct ? (old.bestTimeMs == null ? r.timeMs : smaller(old.bestTimeMs, r.timeMs)) : old.bestTimeMs)
    && n.lastWinDay == (laterWin ? day : old.lastWinDay);
  }
  function validDayKeyOr(day) { return validDayKey(day) ? day : 'invalid'; }

  // ---- Version of the approved card catalogue: the app downloads the cards again only when it moved.
  match /meta/cards {
   allow get: if signedIn();
   allow write: if admin() && request.resource.data.keys().hasOnly(['updatedAt']) && request.resource.data.updatedAt == request.time;
  }

  // ---- Community cards. The document id is the normalized answer, so a word exists only once.
  match /cards/{cardId} {
   // Reading a missing id is allowed so the app can tell a free word from a duplicate.
   allow read: if signedIn() && (resource == null || resource.data.status == 'approved' || resource.data.createdBy == request.auth.uid || admin());
   allow create: if active() && validCard(request.resource.data)
    && request.resource.data.keys().hasOnly(['wordFull','wordNoVowels','normalizedAnswer','hint','category','difficulty','createdBy','createdAt','status','authorName'])
    && cardId == request.resource.data.normalizedAnswer
    // The pseudo shown as "Proposé par" must be the author's own.
    && (!('authorName' in request.resource.data) || request.resource.data.authorName == get(at('users/' + request.auth.uid)).data.username)
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
    && withinProposalQuota();
   // Moderators approve or reject, and may correct the hint, category or difficulty.
   allow update: if admin() && resource.data.status in ['pending','approved','rejected'] && validCard(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','normalizedAnswer','wordNoVowels','hint','category','difficulty','authorName'])
    && (!('authorName' in request.resource.data) || validName(request.resource.data.authorName))
    && request.resource.data.normalizedAnswer == resource.data.normalizedAnswer
    && request.resource.data.status in ['approved','rejected'] && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
   // An author deleting their account takes their name and id off the cards that stay in the game.
   allow update: if signedIn() && resource.data.createdBy == request.auth.uid && resource.data.status == 'approved'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdBy','authorName'])
    && request.resource.data.createdBy == 'deleted' && !('authorName' in request.resource.data);
   // Authors may withdraw a proposal that is not live, and admins may remove anything.
   allow delete: if (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.status != 'approved') || admin();
  }
  // Anti-spam: 30 s between proposals and at most 10 per rolling 24 h. The profile carries the
  // counters and they can only move forward, so a proposal must be paired with a quota update.
  function consumesProposalQuota(before, after) {
   let fresh = !('proposalWindowAt' in before) || request.time > before.proposalWindowAt + duration.value(24, 'h');
   return after.lastProposalAt == request.time
    && (!('lastProposalAt' in before) || request.time > before.lastProposalAt + duration.value(30, 's'))
    && (fresh
      ? (after.proposalWindowAt == request.time && after.proposalCount == 1)
      : (after.proposalWindowAt == before.proposalWindowAt && after.proposalCount == before.proposalCount + 1 && after.proposalCount <= 10));
  }
  function withinProposalQuota() {
   return getAfter(at('users/' + request.auth.uid)).data.get('lastProposalAt', null) == request.time;
  }

  // ---- Reports: one per player and card.
  match /reports/{id} {
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
   allow create: if active()
    && request.resource.data.keys().hasOnly(['userId','cardId','reason','createdAt','status'])
    && request.resource.data.userId == request.auth.uid && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 80
    && id == request.auth.uid + '_' + request.resource.data.cardId
    && get(at('cards/' + request.resource.data.cardId)).data.status == 'approved'
    && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
    && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
    && request.resource.data.status == 'resolved' && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
   allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || admin();
  }

  // ---- Player reports (offensive pseudo): one per reporter and player, on a ranked player only.
  match /playerReports/{id} {
   // The reported player sees and removes the reports that name them only while deleting the account.
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()
    || (resource.data.playerId == request.auth.uid && !exists(at('users/' + request.auth.uid))));
   allow create: if active()
    && request.resource.data.keys().hasOnly(['userId','playerId','username','reason','createdAt','status'])
    && request.resource.data.userId == request.auth.uid && request.resource.data.playerId is string
    && request.resource.data.playerId != request.auth.uid && id == request.auth.uid + '_' + request.resource.data.playerId
    && request.resource.data.username == get(at('leaderboard/' + request.resource.data.playerId)).data.username
    && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
    && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
    && request.resource.data.status == 'resolved' && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
   allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || admin()
    || (resource.data.playerId == request.auth.uid && leaving());
  }

  // ---- Server-only legacy collections (optional Blaze backend).
  match /attempts/{id} {
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
   allow write: if false;
  }
  // Daily words published by a moderator override the app's built-in schedule for that day.
  match /dailyChallenges/{day} {
   allow read: if signedIn();
   allow create, update: if admin() && validDayKey(day)
    && request.resource.data.keys().hasOnly(['cardId','wordFull','hint','category','difficulty','publishedBy','publishedAt'])
    && request.resource.data.cardId is string && request.resource.data.cardId.size() >= 1 && request.resource.data.cardId.size() <= 80
    && request.resource.data.wordFull is string && request.resource.data.wordFull.size() >= 3 && request.resource.data.wordFull.size() <= 80
    && request.resource.data.hint is string && request.resource.data.hint.size() >= 5 && request.resource.data.hint.size() <= 160
    && request.resource.data.category in categories()
    && request.resource.data.difficulty == ['Facile','Moyen','Difficile'][dailyBase(day) / 50 - 1]
    && request.resource.data.publishedBy == request.auth.uid && request.resource.data.publishedAt == request.time;
   allow delete: if admin();
  }

  // ---- Friend challenges: the same 5 public Classique words for two friends, timed by the server.
  // The challenger starts at creation; the friend has 48 h to start; both finish before the 50th hour.
  // A challenge by link has no friend yet (to == ''): anyone signed in may open it by its id (only
  // the invite code leads to it, and ids are not guessable) and the first one to join takes the place.
  match /challenges/{id} {
   allow get: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid
    || resource.data.to == '' || admin());
   allow list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || admin());
   allow create: if active() && (createsChallenge(request.resource.data) || createsOpenChallenge(id, request.resource.data));
   allow update: if active() && (finishesChallenge('from', resource.data, request.resource.data)
    || joinsChallenge(resource.data, request.resource.data)
    || startsChallenge(resource.data, request.resource.data)
    || finishesChallenge('to', resource.data, request.resource.data));
   allow delete: if admin() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) && leaving());
  }
  function challengeCards(c) {
   return c is list && c.size() == 5
    && c[0] is string && c[0].size() >= 1 && c[0].size() <= 80 && c[1] is string && c[1].size() >= 1 && c[1].size() <= 80
    && c[2] is string && c[2].size() >= 1 && c[2].size() <= 80 && c[3] is string && c[3].size() >= 1 && c[3].size() <= 80
    && c[4] is string && c[4].size() >= 1 && c[4].size() <= 80 && c.toSet().size() == 5;
  }
  // Only a player the challenger added as a friend, under the name saved with that friend.
  function createsChallenge(c) {
   return c.keys().hasOnly(['from','fromName','to','toName','cardIds','createdAt','fromStartedAt'])
    && c.from == request.auth.uid && c.to is string && c.to != c.from
    && c.fromName == get(at('users/' + request.auth.uid)).data.username
    && exists(at('users/' + request.auth.uid + '/friends/' + c.to))
    && c.toName == get(at('users/' + request.auth.uid + '/friends/' + c.to)).data.username
    && challengeCards(c.cardIds) && c.createdAt == request.time && c.fromStartedAt == request.time;
  }
  // A challenge by link: no friend named, a code to share, created with its invite in the same batch.
  function createsOpenChallenge(id, c) {
   return c.keys().hasOnly(['from','fromName','to','toName','code','cardIds','createdAt','fromStartedAt'])
    && c.from == request.auth.uid && c.to == '' && c.toName == ''
    && c.fromName == get(at('users/' + request.auth.uid)).data.username
    && c.code is string && c.code.matches('^[A-HJ-NP-Z2-9]{6}$')
    && getAfter(at('challengeInvites/' + c.code)).data.challenge == id
    && challengeCards(c.cardIds) && c.createdAt == request.time && c.fromStartedAt == request.time;
  }
  // The first player to join takes the empty place, under their own name, while it can still be started.
  function joinsChallenge(old, c) {
   return old.to == '' && old.from != request.auth.uid
    && c.diff(old).affectedKeys().hasOnly(['to','toName'])
    && c.to == request.auth.uid && c.toName == get(at('users/' + request.auth.uid)).data.username
    && request.time < old.createdAt + duration.value(48, 'h');
  }
  function startsChallenge(old, c) {
   return old.to == request.auth.uid && !('toStartedAt' in old)
    && c.diff(old).affectedKeys().hasOnly(['toStartedAt']) && c.toStartedAt == request.time
    && request.time < old.createdAt + duration.value(48, 'h');
  }
  // Finish once at the server's time (the score is finish - start), at least 2 s per word found.
  // A skipped word costs 20 s, added by the apps.
  function finishesChallenge(side, old, c) {
   return old[side] == request.auth.uid && (side + 'StartedAt') in old && !((side + 'FinishedAt') in old)
    && c.diff(old).affectedKeys().hasOnly([side + 'FinishedAt', side + 'Skips', side + 'Errors'])
    && c[side + 'FinishedAt'] == request.time && request.time < old.createdAt + duration.value(50, 'h')
    && c[side + 'Skips'] is int && c[side + 'Skips'] >= 0 && c[side + 'Skips'] <= 5
    && c[side + 'Errors'] is int && c[side + 'Errors'] >= 0 && c[side + 'Errors'] <= 500
    && request.time >= old[side + 'StartedAt'] + duration.value((5 - c[side + 'Skips']) * 2, 's');
  }

  match /{document=**} { allow read, write: if false; }
 }
}
