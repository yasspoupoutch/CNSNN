<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cnsnn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Cnsnn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_notification_large</item>
        <item name="postSplashScreenTheme">@style/Theme.Cnsnn</item>
    </style>
    <color name="night">#FF06070C</color>
</resources>
